rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrOwner() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'owner');
    }

    // قواعد المستخدمين
    match /users/{userId} {
      allow read: isAuthenticated() && (request.auth.uid == userId || isAdminOrOwner());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdminOrOwner());
    }

    // قواعد الدروس التعليمية
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (getUserData().role == 'teacher' || isAdminOrOwner());
      allow delete: if isAdminOrOwner();
    }

    // طلبات ربط الأبناء
    match /parent_child_requests/{requestId} {
      allow create: if isAuthenticated() && getUserData().role == 'parent';
      allow read, update: if isAuthenticated() && (isAdminOrOwner() || resource.data.parentId == request.auth.uid);
    }
  }
}
